<?xml version="1.0" encoding="UTF-8"?>
<!-- Astro's CosmicEvolutionKits (/vkit, /evkit): decompiled from the original CosmicEvolutionKit.jar (2019, MC 1.7) and ported to this server.
     Compiled against the current plugin jars in lib/ (copied from the server) so API changes show up at build time. -->
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.conaxgames</groupId>
    <artifactId>EvolutionKits</artifactId>
    <version>0.1</version>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <finalName>CosmicEvolutionKits</finalName>
    </build>

    <dependencies>
        <dependency>
            <groupId>com.conaxgames</groupId>
            <artifactId>server</artifactId>
            <version>1.8.8-R0.2-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>local.evolutionkits</groupId>
            <artifactId>CosmicPvPUtils</artifactId>
            <version>0.1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/../Utils/target/CosmicPvPUtils.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>local.evolutionkits</groupId>
            <artifactId>Arkkit</artifactId>
            <version>0.1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/Arkkit.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>local.evolutionkits</groupId>
            <artifactId>Enchantments</artifactId>
            <version>0.1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/Enchantments.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>local.evolutionkits</groupId>
            <artifactId>SpaceChests</artifactId>
            <version>0.1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/SpaceChests-0.1.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>local.evolutionkits</groupId>
            <artifactId>CosmicSkyCustomItems</artifactId>
            <version>0.1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/CustomItems-0.1.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>local.evolutionkits</groupId>
            <artifactId>Factions</artifactId>
            <version>0.1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/Factions.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>local.evolutionkits</groupId>
            <artifactId>AstroCore</artifactId>
            <version>0.1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/AstroCore.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>local.evolutionkits</groupId>
            <artifactId>Conquest</artifactId>
            <version>0.1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/Conquest-0.1.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>local.evolutionkits</groupId>
            <artifactId>Explosive</artifactId>
            <version>0.1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/Explosive.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>local.evolutionkits</groupId>
            <artifactId>mcMMO</artifactId>
            <version>0.1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/mcMMO.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>local.evolutionkits</groupId>
            <artifactId>EnchantmentsAPI</artifactId>
            <version>0.1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/EnchantmentsAPI.jar</systemPath>
        </dependency>
    </dependencies>
</project>
